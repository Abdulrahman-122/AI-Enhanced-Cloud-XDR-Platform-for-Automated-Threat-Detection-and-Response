# Copy to .env and change every value. Never commit .env.

# Build mode. "true" = deliberately weak lab target. "false" = hardened build of the same app.
VULN_MODE=true

# PostgreSQL passwords (used only inside the Docker network)
POSTGRES_PASSWORD=change-me-postgres
APP_DB_PASSWORD=change-me-app
RO_DB_PASSWORD=change-me-readonly

# Staff admin password. Required for the hardened build (a random one is printed if left empty).
# In the vulnerable build the seeded demo accounts are used (admin / admin123, sales / Welcome1).
ADMIN_PASSWORD=

# Session signing key. Leave empty to use the build's default.
SECRET_KEY=

# File ownership for the backend container (match your user on Linux: run `id -u` and `id -g`)
APP_UID=1000
APP_GID=1000
